# Site Bridge settings. Copy to .env for local development:  cp .env.example .env
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Only GEMINI_API_KEY is needed to run locally. See README.md for what each group does.

# ---------------------------------------------------------------- AI (required)
# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model for the one "understand the site" call per scan, and for the chat agent
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Cost meter shown after each scan (USD per 1M tokens) and the exchange rate
GEMINI_PRICE_IN_PER_M=0.10
GEMINI_PRICE_OUT_PER_M=0.40
USD_INR=88
# Hard cap on Gemini spend per day (India time), chat + scans, in rupees. 0 = no cap.
DAILY_BUDGET_INR=10

# ---------------------------------------------------------------- Access
# Shared password for the whole app (browse, scan, live demos). Empty = open to everyone.
# Set it on any public deployment, or anyone can run scans on your Gemini key.
DEMO_PASSWORD=
# Team password: opens everything DEMO_PASSWORD opens, plus unlimited live-demo questions.
# Can also be entered in a demo panel ("Team member? Unlock unlimited questions").
TEAM_PASSWORD=
# Admin dashboard at /usage (at least 12 characters)
# ADMIN_KEY=

# ---------------------------------------------------------------- Hosting (Vercel)
# Public address of the app. Defaults to the Vercel production URL; set it when you use
# a custom domain. It is written into every WordPress plugin the app generates.
# PUBLIC_URL=https://sitebridge.yourdomain.com
# Second address that serves live demos (a domain added to the same Vercel project).
# Must match the host written in vercel.json.
# DEMO_HOST=your-demo-host.vercel.app
# Scanned sites are saved to Vercel Blob on Vercel. Created for you when you connect a
# Blob store to the project (Storage → Blob, public access).
# BLOB_READ_WRITE_TOKEN=
# Signs chat history and demo passes. Required on Vercel (32+ random characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Locally, a random secret is written to data/chat-secret when this is empty.
# CHAT_SECRET=
# 1 on Vercel or behind any reverse proxy, so rate limits see real visitor IPs
# TRUST_PROXY=1

# ---------------------------------------------------------------- Local ports
# The live preview runs on its own port, one subdomain per site (http://<id>.localhost:4101)
PORT=4100
PREVIEW_PORT=4101
# PREVIEW_URL_TEMPLATE=http://{id}.localhost:4101

# ---------------------------------------------------------------- Scans
# Scans read the home page fully, then linked pages until CRAWL_SECONDS runs out
MAX_PAGES=40
CRAWL_SECONDS=25
DIGEST_CHARS=48000
# Render JavaScript-heavy pages in a headless browser when plain HTML is empty
# (needs a Chromium; locally: npm i playwright && npx playwright install chromium)
RENDER_JS=1
# CHROME_PATH=
# 1 only for local testing against sites on your own network
ALLOW_PRIVATE_URLS=0

# ---------------------------------------------------------------- Chat limits (optional)
# CHAT_MAX_MESSAGE_CHARS=2000
# CHAT_RATE_PER_MIN=20
# CHAT_RATE_PER_HOUR=300
# CHAT_SITE_RATE_PER_MIN=120
# CHAT_SITE_RATE_PER_HOUR=2000

# ---------------------------------------------------------------- Live demo and contact
# Questions a visitor can ask in a live demo, picked from the recommended ones (0 = no limit).
# After that the demo shows "Contact our team for setup". The agent on a customer's own site is never limited.
DEMO_QUESTION_LIMIT=2
# Where "Talk to Us" and "Contact our team for setup" go. CONTACT_URL (a booking page, WhatsApp link
# or form) wins; otherwise CONTACT_EMAIL opens an email with the site's name filled in.
CONTACT_EMAIL=
# CONTACT_URL=https://cal.com/your-team/site-bridge-setup

# ---------------------------------------------------------------- Supabase (optional)
# Turns on usage tracking (visits, scans, demo opens, chats) in Postgres; tables are
# created on first use. Also used by the dormant account / payment code (see README).
# POSTGRES_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Dormant: sign-in emails and UPI payments
# Only used if you restore the account-based flow (see README → Accounts and payments)
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Site Bridge <you@gmail.com>
# RESEND_API_KEY=
# RESEND_FROM=Site Bridge <hello@yourdomain.com>
# UPI_ID=
# UPI_PAYEE=
# DEMO_PACK_PRICE=50
# UNLIMITED_EMAILS=

# ---------------------------------------------------------------- Pine Labs AgenticOrg (optional)
# Hands visitors' order, payment, refund and delivery problems to AgenticOrg's triage agent
# AGENTICORG_API_KEY=
# AGENTICORG_BASE_URL=
